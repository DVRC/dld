ref.o: ref.c defs.h ../system.h ../dld.h
remove.o: remove.c defs.h ../system.h ../dld.h
ul_file.o: ul_file.c defs.h ../dld.h
ul_symbol.o: ul_symbol.c defs.h ../dld.h

